# Settings for the QA Engine. Fill in the values and save as ".env". NEVER put this file inside the zip, in git, or in a chat.

# ---- Supabase (the database the website uses)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# ---- The ingest user (a normal user of the tenant that owns the transcripts)
INGEST_EMAIL=YOUR-INGEST-USER-EMAIL
INGEST_PASSWORD=YOUR-INGEST-USER-PASSWORD

# ---- The restricted database role of the worker (not the postgres admin). Special characters in the password must be URL-encoded.
DATABASE_URL=postgresql://qa_worker.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# ---- Which AI judges the calls
# nano   = Gemini Nano inside Chrome on this laptop (default; needs Chrome, no key)
# gemini = cloud Gemini (needs GOOGLE_API_KEY; no Chrome, no bridge)
AI_PROVIDER=nano

# ---- Only for AI_PROVIDER=gemini: THIS IS WHERE THE GEMINI API KEY GOES
GOOGLE_API_KEY=
# Optional. Default gemini-2.5-flash. For a Gemini 3 model the temperature is set to 1.0 automatically.
GEMINI_MODEL=gemini-2.5-flash
# Optional. Leave empty for the automatic value.
GEMINI_TEMPERATURE=

BRIDGE_URL=http://127.0.0.1:8000
